{
  "expo": {
    "name": "QRelay",
    "slug": "qrelay",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qrelay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.qrelay.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "QRelay reads the sender's screen through the camera. Frames are decoded on this phone and never stored or uploaded.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131614",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qrelay.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F1210"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "QRelay reads the sender's screen through the camera. Frames are decoded on this phone and never stored or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ccbbd7b-d21f-441e-a67c-6865191d7adc"
      }
    },
    "owner": "dev_beans",
    "updates": {
      "url": "https://u.expo.dev/2ccbbd7b-d21f-441e-a67c-6865191d7adc"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
